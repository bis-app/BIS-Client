<Window x:Class="BISClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BISClient.Controls"
        xmlns:vm="clr-namespace:BISClient.ViewModels"
        Title="{Binding WindowTitle}"
        Height="800"
        Width="1280"
        MinWidth="800"
        MinHeight="500"
        Language="de-DE"
        Background="#0F2A36"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Closing="OnClosing"
        Closed="OnClosed"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.InputBindings>
        <KeyBinding Key="T" Modifiers="Control" Command="{Binding NewTabCommand}" />
        <KeyBinding Key="W" Modifiers="Control" Command="{Binding CloseActiveTabCommand}" />
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding ReloadCommand}" />
        <KeyBinding Key="Tab" Modifiers="Control" Command="{Binding NextTabCommand}" />
        <KeyBinding Key="Tab" Modifiers="Control+Shift" Command="{Binding PreviousTabCommand}" />
        <KeyBinding Key="F5" Command="{Binding ReloadCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <Style x:Key="TabItemBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource InactiveTabBrush}" />
            <Setter Property="CornerRadius" Value="6,6,0,0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="2,6,2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="MaxWidth" Value="220" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="{StaticResource ActiveTabBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource ChromeBackgroundBrush}"
                Padding="8,4,8,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,8,4">
                    <Button Style="{StaticResource ChromeButtonStyle}"
                            Content="&#xE72B;"
                            ToolTip="Zurück"
                            Command="{Binding GoBackCommand}" />
                    <Button Style="{StaticResource ChromeButtonStyle}"
                            Content="&#xE72A;"
                            ToolTip="Vor"
                            Command="{Binding GoForwardCommand}" />
                    <Button Style="{StaticResource ChromeButtonStyle}"
                            Content="&#xE72C;"
                            ToolTip="Aktualisieren"
                            Command="{Binding ReloadCommand}" />
                    <Button Style="{StaticResource ChromeButtonStyle}"
                            Content="&#xE710;"
                            ToolTip="Neuer Tab"
                            Command="{Binding NewTabCommand}" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="8,0,0,4"
                            Visibility="{Binding ShowChromeActions, Converter={StaticResource BoolToVisibility}}">
                    <Button Style="{StaticResource ChromeButtonStyle}"
                            Content="&#xE898;"
                            ToolTip="Dateien in den Import-Ordner hochladen"
                            Command="{Binding UploadFilesCommand}"
                            Visibility="{Binding ShowUploadButton, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource ChromeButtonStyle}"
                            Content="&#xE713;"
                            ToolTip="Einstellungen"
                            Command="{Binding OpenSettingsCommand}" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalAlignment="Bottom">
                    <ItemsControl ItemsSource="{Binding Tabs.Tabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:BrowserTabViewModel}">
                                <Border Style="{StaticResource TabItemBorderStyle}">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.ActivateTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding}" />
                                    </Border.InputBindings>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right"
                                                Style="{StaticResource TabCloseButtonStyle}"
                                                Content="&#xE711;"
                                                ToolTip="Tab schließen"
                                                Margin="8,0,0,0"
                                                Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <Image Width="14"
                                               Height="14"
                                               Margin="0,0,6,0"
                                               Stretch="Uniform"
                                               Source="{Binding Favicon}">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Favicon}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="{StaticResource ChromeTextBrush}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                Background="{StaticResource UpdateBannerBrush}"
                Padding="12,8"
                Visibility="{Binding Update.IsBannerVisible, Converter={StaticResource BoolToVisibility}}">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource TabCloseButtonStyle}"
                        Content="&#xE711;"
                        ToolTip="Hinweis schließen"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Command="{Binding DismissUpdateCommand}" />
                <Button DockPanel.Dock="Right"
                        Padding="12,6"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Cursor="Hand"
                        FontSize="12"
                        Foreground="White"
                        Content="Jetzt aktualisieren"
                        Command="{Binding ApplyUpdateCommand}"
                        Visibility="{Binding Update.ShowApplyButton, Converter={StaticResource BoolToVisibility}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{StaticResource UpdateBannerButtonBrush}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#3AA37F" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.6" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Update.BannerText}"
                               Foreground="White"
                               FontSize="13"
                               TextWrapping="Wrap" />
                    <ProgressBar Height="4"
                                 Margin="0,8,0,0"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding Update.Progress}"
                                 Visibility="{Binding Update.IsBusy, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ItemsControl Grid.Row="2" ItemsSource="{Binding Tabs.Tabs}">
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="VerticalAlignment" Value="Stretch" />
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:BrowserTabViewModel}">
                    <controls:BisWebViewHost Visibility="{Binding IsActive, Converter={StaticResource BoolToHidden}}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
