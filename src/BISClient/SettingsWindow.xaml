<Window x:Class="BISClient.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Einstellungen"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#0F2A36"
        Language="de-DE"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="#2A5166"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDefault" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E8A6E" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3D7A94" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsDefault" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#3AA37F" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <StackPanel Margin="20">
        <TextBlock Text="Persönliche Einstellungen"
                   Foreground="White"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,16" />

        <TextBlock Text="Server-Adresse"
                   Foreground="White"
                   FontSize="13"
                   Margin="0,0,0,6" />
        <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}"
                 Height="32"
                 Padding="8,6"
                 FontSize="13" />
        <TextBlock Text="Adresse des BIS-Servers. Leer lassen stellt die Adresse aus der Installation wieder her. Nach dem Speichern einer anderen Adresse werden die offenen Tabs geschlossen."
                   Foreground="#9BB6C3"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,8,0,18" />

        <CheckBox Content="Benachrichtigungen anzeigen"
                  IsChecked="{Binding NotificationsEnabled}"
                  Foreground="White"
                  FontSize="13"
                  Margin="0,0,0,6" />
        <TextBlock Text="Windows-Hinweise erscheinen nur, wenn das Fenster geschlossen ist und der Client im Infobereich bleibt. Bei geöffnetem Fenster zeigt BIS die Toasts in der Web-Ansicht."
                   Foreground="#9BB6C3"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,0,0,18" />

        <CheckBox Content="Hochgeladene Dateien in den Papierkorb verschieben"
                  IsChecked="{Binding DeleteUploadedFiles}"
                  Foreground="White"
                  FontSize="13"
                  Margin="0,0,0,6" />
        <TextBlock Text="Nach einem erfolgreichen Upload wird die Originaldatei in den Papierkorb verschoben. Schlägt das fehl, bleibt die Datei liegen."
                   Foreground="#9BB6C3"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,0,0,18" />

        <TextBlock Text="Upload-Token"
                   Foreground="White"
                   FontSize="13"
                   Margin="0,0,0,6" />
        <PasswordBox x:Name="UploadTokenBox"
                     Height="32"
                     Padding="8,6"
                     FontSize="13" />
        <TextBlock Text="Token im BIS-Profil unter „Datei-Upload per Kurzbefehl“ erzeugen und hier eintragen. Ist ein Token hinterlegt, erscheinen der Upload-Button in der Tableiste sowie Einträge unter „Senden an“ und „Teilen“."
                   Foreground="#9BB6C3"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0" />

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,24,0,0">
            <Button Content="Abbrechen"
                    Style="{StaticResource DialogButtonStyle}"
                    IsCancel="True" />
            <Button Content="Speichern"
                    Style="{StaticResource DialogButtonStyle}"
                    IsDefault="True"
                    Click="OnSaveClick" />
        </StackPanel>
    </StackPanel>
</Window>
