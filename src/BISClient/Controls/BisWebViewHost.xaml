<UserControl x:Class="BISClient.Controls.BisWebViewHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:converters="clr-namespace:BISClient.Converters"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="CollapsedConverter" />
        <Style x:Key="OverlayButton" TargetType="Button">
            <Setter Property="MinWidth" Value="140" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#1B3A4B" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2E5A73" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Background="#0F2A36">
        <wv2:WebView2 x:Name="WebView" />
        <Border Background="#F4F6F7"
                Visibility="{Binding HasError, Converter={StaticResource CollapsedConverter}}">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        MaxWidth="520">
                <TextBlock Text="{Binding ErrorTitle}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#1B3A4B"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding ErrorMessage}"
                           Margin="0,12,0,20"
                           FontSize="14"
                           Foreground="#334155"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Erneut versuchen"
                            Style="{StaticResource OverlayButton}"
                            Command="{Binding RetryCommand}"
                            Visibility="{Binding ShowRetry, Converter={StaticResource CollapsedConverter}}" />
                    <Button Content="Schließen"
                            Style="{StaticResource OverlayButton}"
                            Command="{Binding DismissErrorCommand}"
                            Visibility="{Binding ShowDismiss, Converter={StaticResource CollapsedConverter}}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
